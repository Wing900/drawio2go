# 内置 LLM Provider 配置（可选）
# 启用后会禁用用户添加/编辑 Provider 的功能
# 注意：必须使用 NEXT_PUBLIC_ 前缀才能在客户端访问
# 格式：JSON 字符串
NEXT_PUBLIC_DRAWIO2GO_BUILTIN_PROVIDER='{"displayName":"内置AI","providerType":"openai-compatible","apiUrl":"https://api.example.com/v1","apiKey":"sk-your-api-key","models":[{"modelName":"gpt-4","displayName":"GPT-4","temperature":0.7}]}'

# 多模型示例
# NEXT_PUBLIC_DRAWIO2GO_BUILTIN_PROVIDER='{"displayName":"企业AI","providerType":"openai-compatible","apiUrl":"https://api.openai.com/v1","apiKey":"sk-xxx","models":[{"modelName":"gpt-4","displayName":"GPT-4","temperature":0.7,"isDefault":true},{"modelName":"gpt-4o","displayName":"GPT-4o","temperature":0.3},{"modelName":"gpt-3.5-turbo","displayName":"GPT-3.5","temperature":0.5}]}'

# DeepSeek 示例
# NEXT_PUBLIC_DRAWIO2GO_BUILTIN_PROVIDER='{"displayName":"DeepSeek","providerType":"deepseek-native","apiUrl":"https://api.deepseek.com","apiKey":"sk-xxx","models":[{"modelName":"deepseek-chat","displayName":"DeepSeek Chat","temperature":0.7}]}'
